{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/be-ai/api/:path*",
      "destination": "https://api.ocur.ai/api/be-ai/:path*"
    },
    {
      "source": "/leads/api/:slug",
      "destination": "https://api.ocur.ai/api/leads/:slug"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.ocur\\.ai" }],
      "destination": "https://ocur.ai/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "ocur-lang", "value": "de" }],
      "destination": "/de",
      "permanent": false
    },
    {
      "source": "/de",
      "has": [{ "type": "cookie", "key": "ocur-lang", "value": "en" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/",
      "missing": [{ "type": "cookie", "key": "ocur-lang" }],
      "has": [{ "type": "header", "key": "accept-language", "value": "de.*" }],
      "destination": "/de",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/be-ai/api/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/leads/api/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
