# PostHog product analytics.
# Copy to .env for local dev, and set the same vars in the Vercel project
# (Settings → Environment Variables). Without VITE_POSTHOG_KEY, analytics
# stays off. The project API key (phc_…) is public / write-only — it's
# meant to ship in the browser, so this isn't a secret.
VITE_POSTHOG_KEY=

# Region host. Defaults to EU cloud (https://eu.i.posthog.com) when unset;
# set to https://us.i.posthog.com for a US-cloud project.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# X (Twitter) Ads conversion tracking.
# The base pixel (id reji3) is inline in every page's <head> and needs no
# config. Conversion events need an event created in X Events Manager
# (Ads Manager → Tools → Events Manager → pixel reji3 → Add events); that
# yields a tw-reji3-… event id. Event ids are public by design — they ship
# in page source — so the VITE_ one is not a secret.
#
# Browser leg: twq('event', …) fired on Start-free clicks (src/xads.js).
VITE_X_EVENT_ID_CTA_CLICK=
# Server leg: same id, read by the Conversions API relay api/x-conversions.js.
X_EVENT_ID_CTA_CLICK=
# The same pair for demo bookings — a click on any "Book a demo" link (the
# founder's booking page). Its own event in Events Manager, so X can
# optimise for booked calls separately from sign-ups.
VITE_X_EVENT_ID_BOOK_DEMO=
X_EVENT_ID_BOOK_DEMO=
# Conversions API token from Events Manager — a REAL SECRET. Set it only in
# Vercel (Settings → Environment Variables), never in a committed file.
X_PIXEL_TOKEN=
# Optional relay overrides (defaults: reji3, 12).
# X_PIXEL_ID=reji3
# X_ADS_API_VERSION=12
